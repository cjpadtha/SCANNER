//@version=6
// Educational study tool. Not financial advice. Past results do not predict future results.
// Same scoring as nq_scanner.py (POC, liquidity sweep, FVGs, engulfing, opening range).
// News is not available in Pine Script, so it is not part of the score.
indicator("NQ Confluence Scanner", shorttitle = "NQ Confluence", overlay = true, max_bars_back = 5000, max_boxes_count = 60, max_lines_count = 60)

// ================= Inputs =================
string TZ          = "America/New_York"
int   lookbackDays = input.int(5, "Volume profile lookback (days)", minval = 1, maxval = 20)
float binSize      = input.float(5.0, "Profile bin size (points)", minval = 0.25)
int   minScore     = input.int(3, "Confluence needed for a bias", minval = 1, maxval = 5)
int   sweepBars    = input.int(6, "Sweep counts for (bars)", minval = 1)
int   fvgKeep      = input.int(5, "Recent unfilled FVGs scored", minval = 1, maxval = 20)
bool  rthOnly      = input.bool(true, "Signals only 09:35-15:55 ET")

// ~23 trading hours per futures day, capped by Pine's history limit
int lookback = math.min(4900, int(math.round(lookbackDays * 23.0 * 3600.0 / timeframe.in_seconds())))

// ================= 1. Volume profile (rolling, incremental) =================
var map<int, float> prof = map.new<int, float>()
int kNow = math.round(hlc3 / binSize)
prof.put(kNow, nz(prof.get(kNow)) + nz(volume))
if bar_index >= lookback
    int kOld = math.round(hlc3[lookback] / binSize)
    float remaining = nz(prof.get(kOld)) - nz(volume[lookback])
    if remaining <= 1e-9
        prof.remove(kOld)
    else
        prof.put(kOld, remaining)

float pocVol = -1.0
int pocKey = na
for [k, v] in prof
    if v > pocVol
        pocVol := v
        pocKey := k
float poc = na(pocKey) ? na : pocKey * binSize

// ================= 2. Key levels =================
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
bool newDay = timeframe.change("D")     // CME futures day starts 18:00 ET

bool inOR = not na(time(timeframe.period, "0930-1000", TZ))
var float orh = na
var float orl = na
if newDay
    orh := na
    orl := na
if inOR
    orh := na(orh) ? high : math.max(orh, high)
    orl := na(orl) ? low : math.min(orl, low)

// ================= 3. Liquidity sweeps (only recent ones count) =================
var int sweepBar = na
var int sweepDir = 0
if newDay
    sweepBar := na
    sweepDir := 0
if high > pdh and close < pdh
    sweepBar := bar_index
    sweepDir := -1
if low < pdl and close > pdl
    sweepBar := bar_index
    sweepDir := 1
bool sweepActive = not na(sweepBar) and bar_index - sweepBar <= sweepBars - 1

// ================= 4. Fair value gaps =================
var array<float> fTop = array.new<float>()
var array<float> fBot = array.new<float>()
var array<int>   fDir = array.new<int>()
var array<int>   fBar = array.new<int>()

// drop gaps this bar filled, or that fell out of the lookback window
if fDir.size() > 0
    for i = fDir.size() - 1 to 0
        bool filled = fDir.get(i) == 1 ? low <= fBot.get(i) : high >= fTop.get(i)
        if filled or bar_index - fBar.get(i) > lookback
            fTop.remove(i)
            fBot.remove(i)
            fDir.remove(i)
            fBar.remove(i)

if low > high[2]
    fTop.push(low)
    fBot.push(high[2])
    fDir.push(1)
    fBar.push(bar_index)
else if high < low[2]
    fTop.push(low[2])
    fBot.push(high)
    fDir.push(-1)
    fBar.push(bar_index)
if fDir.size() > 60
    fTop.shift()
    fBot.shift()
    fDir.shift()
    fBar.shift()

int bullFvg = 0
int bearFvg = 0
int fvgStart = math.max(0, fDir.size() - fvgKeep)
if fDir.size() > 0
    for i = fvgStart to fDir.size() - 1
        if fDir.get(i) == 1 and fTop.get(i) < close
            bullFvg += 1
        if fDir.get(i) == -1 and fBot.get(i) > close
            bearFvg += 1

// ================= 5. Patterns =================
bool bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// ================= Score =================
int fPoc   = na(poc) ? 0 : close > poc ? 1 : -1
int fSweep = sweepActive ? sweepDir : 0
int fFvg   = bullFvg > bearFvg ? 1 : bearFvg > bullFvg ? -1 : 0
int fEng   = (bullEng ? 1 : 0) - (bearEng ? 1 : 0)
int fOr    = na(orh) ? 0 : close > orh ? 1 : close < orl ? -1 : 0
int score  = fPoc + fSweep + fFvg + fEng + fOr

bool inRTH     = not na(time(timeframe.period, "0935-1600", TZ))
bool canSignal = not rthOnly or inRTH
int  side      = score >= minScore ? 1 : score <= -minScore ? -1 : 0
bool longSig   = canSignal and side == 1 and side[1] != 1
bool shortSig  = canSignal and side == -1 and side[1] != -1

// ================= Display =================
bool showKz  = input.bool(true, "Shade NY killzones", group = "Display")
bool showFvg = input.bool(true, "Draw unfilled FVGs", group = "Display")
bool showHvn = input.bool(true, "Draw nearest HVNs", group = "Display")

plot(poc, "POC", color.orange, 2, plot.style_linebr)
plot(pdh, "PDH", color.new(color.red, 30), 1, plot.style_linebr)
plot(pdl, "PDL", color.new(color.green, 30), 1, plot.style_linebr)
plot(orh, "ORH", color.new(color.gray, 20), 1, plot.style_linebr)
plot(orl, "ORL", color.new(color.gray, 20), 1, plot.style_linebr)
plot(score, "Score", display = display.data_window)

plotshape(longSig, "Long signal", shape.triangleup, location.belowbar, color.lime, size = size.small, text = "L")
plotshape(shortSig, "Short signal", shape.triangledown, location.abovebar, color.red, size = size.small, text = "S")

bool kzAM = not na(time(timeframe.period, "0930-1100", TZ))
bool kzPM = not na(time(timeframe.period, "1330-1600", TZ))
bgcolor(showKz and kzAM ? color.new(color.blue, 92) : showKz and kzPM ? color.new(color.purple, 94) : na)

alertcondition(longSig, "NQ confluence LONG", "NQ confluence LONG bias, score {{plot(\"Score\")}} at {{close}}")
alertcondition(shortSig, "NQ confluence SHORT", "NQ confluence SHORT bias, score {{plot(\"Score\")}} at {{close}}")
alertcondition(longSig or shortSig, "NQ confluence ANY signal", "NQ confluence signal, score {{plot(\"Score\")}} at {{close}}")

fmt(int v) => v > 0 ? "+" + str.tostring(v) : str.tostring(v)
clr(int v) => v > 0 ? color.lime : v < 0 ? color.red : color.gray

var table tbl = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 25), border_width = 1)
var array<line> hvnLines = array.new<line>()
var array<box>  fvgBoxes = array.new<box>()

if barstate.islast
    // ----- score table -----
    table.cell(tbl, 0, 0, "POC " + str.tostring(poc, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, fmt(fPoc), text_color = clr(fPoc), text_size = size.small)
    table.cell(tbl, 0, 1, "Liquidity sweep", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 1, fmt(fSweep), text_color = clr(fSweep), text_size = size.small)
    table.cell(tbl, 0, 2, "FVGs  bull " + str.tostring(bullFvg) + " / bear " + str.tostring(bearFvg), text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 2, fmt(fFvg), text_color = clr(fFvg), text_size = size.small)
    table.cell(tbl, 0, 3, "Engulfing", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 3, fmt(fEng), text_color = clr(fEng), text_size = size.small)
    table.cell(tbl, 0, 4, "Opening range", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 4, fmt(fOr), text_color = clr(fOr), text_size = size.small)
    table.cell(tbl, 0, 5, "TOTAL", text_color = color.white, text_size = size.normal)
    table.cell(tbl, 1, 5, fmt(score), text_color = clr(score), text_size = size.normal)
    string verdict = side == 1 ? "LONG bias" : side == -1 ? "SHORT bias" : "No clear edge"
    table.cell(tbl, 0, 6, verdict, text_color = clr(side), text_size = size.small)
    table.cell(tbl, 1, 6, "", text_size = size.small)

    // ----- unfilled FVG boxes -----
    for b in fvgBoxes
        b.delete()
    fvgBoxes.clear()
    if showFvg and fDir.size() > 0
        for i = fvgStart to fDir.size() - 1
            color c = fDir.get(i) == 1 ? color.new(color.lime, 85) : color.new(color.red, 85)
            fvgBoxes.push(box.new(left = fBar.get(i) - 2, top = fTop.get(i), right = bar_index + 10, bottom = fBot.get(i), border_color = c, bgcolor = c))

    // ----- nearest HVNs (local volume peaks in the top 30% of the profile) -----
    for ln in hvnLines
        ln.delete()
    hvnLines.clear()
    array<int> keys = prof.keys()
    keys.sort()
    int nK = keys.size()
    if showHvn and nK >= 3
        array<float> vols = array.new<float>()
        for kk in keys
            vols.push(prof.get(kk))
        float cut = vols.percentile_linear_interpolation(70)
        array<float> above = array.new<float>()
        array<float> below = array.new<float>()
        for i = 1 to nK - 2
            float v = vols.get(i)
            if v >= cut and v >= vols.get(i - 1) and v >= vols.get(i + 1)
                float px = keys.get(i) * binSize
                if px > close
                    above.push(px)
                else if px < close
                    below.push(px)
        above.sort(order.ascending)
        below.sort(order.descending)
        if above.size() > 0
            for i = 0 to math.min(3, above.size()) - 1
                hvnLines.push(line.new(bar_index - 40, above.get(i), bar_index + 10, above.get(i), color = color.new(color.aqua, 20), style = line.style_dotted, width = 2))
        if below.size() > 0
            for i = 0 to math.min(3, below.size()) - 1
                hvnLines.push(line.new(bar_index - 40, below.get(i), bar_index + 10, below.get(i), color = color.new(color.aqua, 20), style = line.style_dotted, width = 2))
